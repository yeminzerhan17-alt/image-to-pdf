{
  "name": "image-to-pdf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Client-only iPhone web app: photos to PDF with page reordering",
  "license": "MIT",
  "author": "Yemin Zerhan",
  "homepage": "https://github.com/yeminzerhan17-alt/image-to-pdf#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yeminzerhan17-alt/image-to-pdf.git"
  },
  "bugs": "https://github.com/yeminzerhan17-alt/image-to-pdf/issues",
  "keywords": [
    "pdf",
    "scanner",
    "images",
    "pwa",
    "ios",
    "offline-first",
    "typescript",
    "preact"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "bundle": "node scripts/bundle-code.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "exifr": "^7.1.3",
    "idb-keyval": "^6.2.1",
    "pdf-lib": "^1.17.1",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
